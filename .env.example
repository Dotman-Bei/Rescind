# Rescind configuration (PRD §21). Copy to .env and fill in.
STRIKE_ENV=mainnet
DATABASE_URL=file:./rescind.db
BREACH_KEY_ENCRYPTION_SECRET=
BREACH_ADMIN_PASSPHRASE=
# Builder Connect (P1); leave empty to offer paste-key only
BREACH_BUILDER_CODE=
# 1 enables /dev/leader for the demo vault; never set in production
BREACH_DEMO_MODE=0
# Timezone the operator screens display times in
NEXT_PUBLIC_OPERATOR_TZ=Africa/Lagos
